<Page
    x:Class="Stremio.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Stremio"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vlc="using:LibVLCSharp.Platforms.Windows"
    mc:Ignorable="d"
    Background="Black">

    <Grid Background="Black">
        <!-- VLC draws the video here. The web page above turns transparent while a stream plays,
             so Stremio's own player controls and subtitles sit on top of VLC's picture.
             Created only once the web app has loaded (x:Load), so a VLC problem can't stop Stremio starting. -->
        <vlc:VideoView x:Name="VideoView"
                       x:Load="False"
                       SizeChanged="VideoView_SizeChanged"
                       Opacity="0"
                       IsHitTestVisible="False"
                       IsTabStop="False" />

        <!-- The controller drives the page as a keyboard (see ControllerBridge). -->
        <controls:WebView2 x:Name="WebView" />

        <Grid x:Name="LoadErrorPanel" Background="#FF0C0B11" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Padding="24" Spacing="16">
                <TextBlock Text="Couldn't load Stremio" FontSize="28" Foreground="White" HorizontalAlignment="Center" />
                <TextBlock x:Name="LoadErrorText" Foreground="#B3FFFFFF" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="RetryButton" Content="Retry" MinWidth="160" HorizontalAlignment="Center" Click="RetryButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
